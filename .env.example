# Copy to .env and fill in.
OPENAI_API_KEY=sk-...

# Model used by all agents (see https://platform.openai.com/docs/models)
AGENT_MODEL=gpt-4o

# Embedding model for vector search
EMBEDDING_MODEL=text-embedding-3-small

# Where uploaded documents are stored
UPLOAD_DIR=./data/uploads

# Persistent vector store location
VECTOR_STORE_DIR=./data/chroma

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
